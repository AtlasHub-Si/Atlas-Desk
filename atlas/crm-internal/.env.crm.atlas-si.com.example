# AtlasHub Internal Group CRM — crm.atlas-si.com
# Copie para .env na VPS e preencha os segredos reais. NUNCA commitar!

# ── URL Canônica Interna ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://crm.atlas-si.com
NEXT_PUBLIC_ADMIN_URL=https://crm.atlas-si.com
DOMAIN=crm.atlas-si.com
APP_LOCALE=pt-BR

# ── Governança Interna (NÃO SaaS aberto) ──────────────────────────────────────
# 'so_convite' bloqueia /signup público e exige convite válido (lib/auth/politica-de-cadastro.ts)
SIGNUP_MODE=so_convite
TENANT_PROVISIONING_SECRET=

# ── Supabase (Usar Master AtlasHub conforme FOUNDATION-01 ou instância dedicada)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me-anon-key
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
SUPABASE_SERVER_URL=

# ── Segredos Internos, Criptografia & Redis ───────────────────────────────────
INTERNAL_SECRET=change-me-32chars-internal-secret
SRH_TOKEN=change-me-srh-token
CPF_ENCRYPTION_KEY=change-me-cpf-key
AI_CRED_AES_KEY=change-me-32byte-base64-aes-key
WAHA_BYO_ENCRYPTION_KEY=change-me-waha-byo-key

# ── WAHA (WhatsApp) ───────────────────────────────────────────────────────────
WAHA_API_BASE_URL=http://waha:3000
WAHA_API_KEY=change-me-waha-plaintext-key
WAHA_API_KEY_SHA512=change-me-sha512-of-waha-key
WAHA_HMAC_SECRET=change-me-waha-hmac-secret

# ── Integração com AtlasPayBridge (pay.atlas-si.com) ───────────────────────────
ATLAS_PAY_BRIDGE_URL=https://pay.atlas-si.com
ATLAS_PAY_BRIDGE_ADMIN_KEY=change-me-same-as-pay-bridge-admin-key

# ── Segurança Caddy / ACME ────────────────────────────────────────────────────
ACME_EMAIL=infra@atlashub.si
APP_MEM_LIMIT=768m
WORKER_MEM_LIMIT=512m
WAHA_MEM_LIMIT=1280m
